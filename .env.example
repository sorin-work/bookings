# Copy to .env and adjust. docker compose reads .env automatically.

# Host ports (container ports stay the same)
DB_PORT=5446
APP_PORT=4406
MAILPIT_UI_PORT=8026

# Postgres credentials used by the db and app services
POSTGRES_USER=bookings
POSTGRES_PASSWORD=bookings
POSTGRES_DB=bookings

# Signs sessions and booking links. Use a long random value anywhere but your laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=local-docker-secret-change-me
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Create demo@example.com / demo-password with a salon and sample bookings on first start.
SEED_DEMO=true

# Behind https (a reverse proxy that terminates TLS), turn these on.
# SECURE_COOKIES=true
# BEHIND_PROXY=true
# SECURE_HSTS_SECONDS=31536000

# plain or json
LOG_FORMAT=plain
